# Backend only. Never place these values in frontend environment files.
OPENAI_API_KEY=
# Select an available Responses API model supporting function calling and structured outputs.
OPENAI_MODEL=
# Optional development provider: LLM_PROVIDER=openrouter uses the same Responses client against https://openrouter.ai/api/v1.
# OpenAI stays the default. Pin one model for reproducible runs.
LLM_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b-20260604:free
# Dated Bank of Canada CAD conversions (latest published day within 7 days); no execution quotes.
BOC_FX_ENABLED=true
# Optional absolute path to a backend-owned, independently reviewed reference JSON.
# See docs/financial-sources.md. Never point this at a user-uploaded file.
FINANCIAL_REFERENCE_FILE=

# Optional backend-owned primary filing/issuer extracts, keyed by company ID.
# See docs/us-stock-analysis.md; never use a user-uploaded file.
RESEARCH_REFERENCE_FILE=

# Optional bounded dated opportunity universe (at most eight candidates).
# Re-read and screened each new-cash request; see docs/new-cash-allocation.md.
DISCOVERY_REFERENCE_FILE=

# EODHD key (free plan is enough: 20 requests a day). Delayed quotes and TSX identity. Backend only.
EODHD_API_KEY=
# SEC requires a contact User-Agent, e.g. "Your Name you@example.com". Identifies US stocks for free.
SEC_USER_AGENT=
# OpenFIGI identity fallback when SEC cannot identify a holding (free; a key only raises the rate limit). Never prices.
OPENFIGI_ENABLED=true
OPENFIGI_API_KEY=
